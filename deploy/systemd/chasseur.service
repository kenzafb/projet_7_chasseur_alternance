[Unit]
Description=Chasseur : application web (http://localhost:5002)

[Service]
# Adapter ce chemin si le projet est ailleurs
WorkingDirectory=%h/Bureau/workspace/chasseur
ExecStart=%h/Bureau/workspace/chasseur/venv/bin/uvicorn main:app --host 127.0.0.1 --port 5002
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
