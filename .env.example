# Copier vers .env et remplir. Toutes les variables lues par le projet actif.

# Session web : clé de signature des cookies, OBLIGATOIRE (32 caractères minimum,
# sinon l'application refuse de démarrer). Pour en générer une :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Cookie de session envoyé seulement en HTTPS : true en production, false en local
COOKIE_SECURE=false

# Code à saisir pour créer un compte sur /register. Vide : inscriptions fermées.
CODE_INVITATION=

# Base de données, créée par "alembic upgrade head" (défaut si vide : sqlite data/chasseur.db,
# l'ancienne base). Chemin absolu : 4 barres obliques après "sqlite:".
DATABASE_URL=sqlite:////chemin/absolu/vers/chasseur_alternance/data/chasseur_v2.db

# Mistral AI (analyse des offres, lettres, extraction des contacts)
MISTRAL_API_KEY=

# France Travail, API Offres d'emploi v2
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# La Bonne Alternance
LBA_API_KEY=

# INSEE Sirene (candidatures spontanées)
INSEE_API_KEY=

# Gmail SMTP (envoi des candidatures spontanées)
GMAIL_SENDER=
GMAIL_APP_PASSWORD=

# Logs détaillés du scraper d'emails (true pour activer)
DEBUG_SCRAPER=
