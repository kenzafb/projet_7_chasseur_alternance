# Copier vers .env et remplir. Toutes les variables lues par le projet actif.

# Session web : clé de signature des cookies, OBLIGATOIRE (32 caractères minimum,
# sinon l'application refuse de démarrer). Pour en générer une :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Cookie de session envoyé seulement en HTTPS : true en production, false en local
COOKIE_SECURE=false

# Code à saisir pour créer un compte sur /register. Vide : inscriptions fermées.
CODE_INVITATION=

# Clé de chiffrement des mots de passe SMTP des comptes d'envoi (Fernet).
# Absente ou invalide : l'application démarre, mais configuration et envoi de
# mails sont désactivés. Ne plus la changer une fois des comptes enregistrés
# (ils devraient ressaisir leur mot de passe). Pour en générer une :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLE_CHIFFREMENT=

# Base de données, créée par "alembic upgrade head" (défaut si vide : sqlite data/chasseur.db,
# l'ancienne base). Chemin absolu : 4 barres obliques après "sqlite:".
DATABASE_URL=sqlite:////chemin/absolu/vers/chasseur_alternance/data/chasseur_v2.db

# Interrupteur de l'IA (défaut true). false : aucun appel à Mistral ; les offres
# sont ajoutées « non analysées » (sans score), la lettre automatique et la
# validation des emails par l'IA sont indisponibles, le scraper lit les pages
# directement (emails notés non validés).
# Désactivée pour l'instant : voir l'encadré sur l'IA en tête du README.
ANALYSE_IA=false

# Mistral AI (analyse des offres, lettres, extraction des contacts)
MISTRAL_API_KEY=
# Modèles : un par usage, sinon MODELE_MISTRAL pour tous, sinon les défauts
# (analyse et lettre : mistral-medium-latest, extraction : mistral-small-latest).
# Vérifier ceux que la clé autorise : python scripts/verifier_mistral.py
MODELE_MISTRAL=
MODELE_MISTRAL_ANALYSE=
MODELE_MISTRAL_LETTRE=
MODELE_MISTRAL_EXTRACTION=

# France Travail, API Offres d'emploi v2
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# La Bonne Alternance
LBA_API_KEY=

# INSEE Sirene (candidatures spontanées)
INSEE_API_KEY=

# Envoi des candidatures spontanées : chaque utilisateur configure SON compte
# d'envoi dans Profil (aucun compte commun ici). Plafond de mails par
# utilisateur et par jour, tous lancements confondus (défaut 50).
PLAFOND_ENVOIS_JOUR=50

# Logs détaillés du scraper d'emails (true pour activer)
DEBUG_SCRAPER=
