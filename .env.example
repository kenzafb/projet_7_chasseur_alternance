# Copier vers .env et remplir. Toutes les variables lues par le projet actif.

# Session web : clé de signature des cookies, OBLIGATOIRE (32 caractères minimum,
# sinon l'application refuse de démarrer). Pour en générer une :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Cookie de session envoyé seulement en HTTPS : true en production, false en local
COOKIE_SECURE=false

# Code à saisir pour créer un compte sur /register. Vide : inscriptions fermées.
CODE_INVITATION=

# Clé de chiffrement des mots de passe SMTP des comptes d'envoi (Fernet).
# Absente ou invalide : l'application démarre, mais configuration et envoi de
# mails sont désactivés. Ne plus la changer une fois des comptes enregistrés
# (ils devraient ressaisir leur mot de passe). Pour en générer une :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLE_CHIFFREMENT=

# Base de données, créée par "alembic upgrade head" (défaut si vide : sqlite data/chasseur.db,
# l'ancienne base). Chemin absolu : 4 barres obliques après "sqlite:".
DATABASE_URL=sqlite:////chemin/absolu/vers/chasseur_alternance/data/chasseur_v2.db

# Interrupteur général de l'IA (défaut true). false : aucun appel à l'IA ; les
# offres restent « non analysées » (sans score), la lettre automatique et la
# validation des emails douteux par l'IA sont indisponibles (les règles de
# shared/referentiels/validation_emails.txt s'appliquent toujours).
ANALYSE_IA=true

# IA locale : Ollama (voir le README : installation, modèles,
# OLLAMA_MAX_LOADED_MODELS=1 si peu de RAM).
# Vérifier l'installation : venv/bin/python scripts/verifier_ia_locale.py
# API : ollama (défaut, API native /api/chat : réflexion coupée et schéma JSON
# imposés de façon documentée) ou openai (format compatible OpenAI, autre serveur)
IA_API=ollama
# Racine du serveur (openai : avec /v1, par exemple http://localhost:11434/v1)
IA_BASE_URL=http://localhost:11434
# Clé, seulement si le serveur en demande une (Ollama : vide)
IA_API_KEY=
# Modèle par usage (défauts : ministral-3:8b, ministral-3:8b, ministral-3:3b)
IA_MODELE_ANALYSE=ministral-3:8b
IA_MODELE_LETTRE=ministral-3:8b
IA_MODELE_EXTRACTION=ministral-3:3b
# Attente maximale d'une réponse, en secondes (défaut 600 ; chargement du
# modèle compris, compter une à deux minutes par offre sur processeur)
IA_DELAI_S=600
# Caractères de la description d'une offre envoyés à l'IA (défaut 2000)
IA_LONGUEUR_DESCRIPTION=2000
# Contexte demandé à Ollama, en tokens (défaut 8192 ; le défaut d'Ollama peut
# tronquer un prompt sans prévenir)
IA_NUM_CTX=8192
# Durée pendant laquelle Ollama garde le modèle chargé après un appel (défaut 10m)
IA_KEEP_ALIVE=10m
# Mode de réflexion des modèles qui en ont un (Qwen 3...) : false (défaut)
IA_REFLEXION=false

# France Travail, API Offres d'emploi v2
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# La Bonne Alternance
LBA_API_KEY=

# INSEE Sirene (candidatures spontanées)
INSEE_API_KEY=

# Envoi des candidatures spontanées : chaque utilisateur configure SON compte
# d'envoi dans Profil (aucun compte commun ici). Plafond de mails par
# utilisateur et par jour, tous lancements confondus (défaut 50).
PLAFOND_ENVOIS_JOUR=50

# Logs détaillés du scraper d'emails (true pour activer)
DEBUG_SCRAPER=
